{
  "version": "2.0.0",
  "name": "wikidocs-desktop",
  "productName": "WikiDocs",
  "description": "Just a databaseless markdown flat-file wiki application",
  "author": "Manuel Zavatta <manuel.zavatta@gmail.com>",
  "license": "MIT",
  "private": false,
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "prestart": "npm --prefix ../backend run build && npm --prefix ../frontend run build",
    "package": "node ./scripts/verify-runtime-artifacts.js && electron-forge package",
    "make": "node ./scripts/verify-runtime-artifacts.js && electron-forge make",
    "publish": "node ./scripts/verify-runtime-artifacts.js && electron-forge publish",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "packageManager": "npm",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "43.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "~4.5.4"
  }
}
