{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "entryFile": "backend/src/main",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "index.md",
        "outDir": "dist/backend/src"
      }
    ],
    "plugins": [
      {
        "name": "@nestjs/swagger/plugin",
        "options": {
          "classValidatorShim": true,
          "dtoFileNameSuffix": [
            ".type.ts",
            ".types.ts",
            ".schema.ts",
            ".schemas.ts"
          ]
        }
      }
    ]
  }
}
